    "isomorphic-fetch": "^2.2.1",
    "lodash": "^4.17.21",
    "normalizr": "^3.6.2",
    "octokit": "^4.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.2.0",
    "react-router": "^6.30.0",
    "react-router-dom": "^6.30.0",
