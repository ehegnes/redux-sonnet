  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "lint": "eslint .",
		"format": "NODE_OPTIONS='--experimental-strip-types' prettier 'src/**/*.{ts,tsx}' --write",
